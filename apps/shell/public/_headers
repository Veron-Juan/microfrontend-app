# Headers for Cloudflare (Pages or Workers) and Netlify, which use this format. Vite copies it to dist/.

# Security: the browser doesn't guess file types, nobody can frame the page and no permissions the
# app doesn't use get requested. The deploy adds the Content-Security-Policy (scripts/discovery.ts).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Discovery says which version of each remote runs: if it gets cached, a rollback isn't seen.
/remotes.json
  Cache-Control: no-cache

# Files with a hash in their name never change: one year of cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
