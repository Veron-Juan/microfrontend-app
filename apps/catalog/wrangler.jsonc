// Cloudflare deploy (Workers with static assets): publishes dist/ as is, with its _headers.
{
  "name": "mfe-anatomia-catalog",
  "compatibility_date": "2026-10-01",
  // Production URL only: no preview URLs for each uploaded version.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
  },
}
