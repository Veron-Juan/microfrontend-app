# Headers for Cloudflare (Pages or Workers) and Netlify, which use this format. Vite copies it to dist/.

# The shell loads this remote from another origin: all of its files need CORS.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Files with a hash in their name never change: one year of cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry points change on every deploy: the browser must always revalidate them.
/mf-manifest.json
  Cache-Control: no-cache
/remoteEntry.js
  Cache-Control: no-cache
