// Deploy en Cloudflare (Workers con archivos estáticos): publica dist/ tal cual, con su _headers.
{
  "name": "mfe-anatomia-guide",
  "compatibility_date": "2026-10-01",
  "assets": {
    // El shell pide /fragment/guide.html tal cual: sin esto, Cloudflare lo redirigiría a /fragment/guide.
    "html_handling": "none",
    "directory": "./dist",
  },
}
