// Cloudflare deploy (Workers with static assets): publishes dist/ as is, with its _headers and
// _redirects (the latter serves index.html at /, which html_handling "none" no longer does).
{
  "name": "mfe-anatomia-guide",
  "compatibility_date": "2026-10-01",
  // Production URL only: no preview URLs for each uploaded version.
  "preview_urls": false,
  "assets": {
    // The shell requests /fragment/guide.html as is: without this, Cloudflare would redirect it to /fragment/guide.
    "html_handling": "none",
    "directory": "./dist",
  },
}
