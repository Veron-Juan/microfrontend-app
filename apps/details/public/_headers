# Cabeceras para Cloudflare (Pages o Workers) y Netlify, que usan este formato. Vite lo copia a dist/.

# El shell carga este remote desde otro origen: todos sus archivos necesitan CORS.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Los archivos con hash en el nombre nunca cambian: un año de caché.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Los puntos de entrada cambian en cada deploy: el navegador debe revalidarlos siempre.
/mf-manifest.json
  Cache-Control: no-cache
/remoteEntry.js
  Cache-Control: no-cache
